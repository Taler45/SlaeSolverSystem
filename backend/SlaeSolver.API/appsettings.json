{
  "Jwt": {
    "ExpireHours": 24
  },
  "Limits":{
    "MaxMatrixSize": 2000,
    "MaxActiveTasks": 3,
    "MaxSolveSeconds": 100
  },
  "Storage": {
    "Root": "C:/slae-storage"
  },
  "Solver": {
    "Epsilon": 1e-10,
    "MaxIterations": 100000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
